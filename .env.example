# ==============================================================================
# ERP SaaS - Environment Variables Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="ERP SaaS Enterprise"
API_V1_STR=/api/v1
SECRET_KEY="generate-a-strong-secret-key-for-jwt-signing"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Database (Local or AWS RDS Free Tier)
# AWS RDS: postgresql+asyncpg://<db_user>:<db_pass>@<rds_endpoint>:5432/<db_name>
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_saas_db
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database Connection Pool (Tuned for AWS RDS Free Tier db.t3.micro / db.t4g.micro)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Cryptography Master Key (AES-256 for SAT CSD Private Keys encryption at rest)
CSD_ENCRYPTION_KEY="32-byte-base64-encoded-secure-master-key"

# SAT / PAC Provider (Testing & Production)
PAC_PROVIDER=finkok
PAC_USERNAME=
PAC_PASSWORD=
PAC_ENVIRONMENT=sandbox
